# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Real semantic retrieval; falls back visibly to full-text search if unavailable.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDINGS_ENABLED=true
# live requires the key. rehearsal is an explicitly labeled deterministic adapter.
AGENT_MODE=live
FALKOR_HOST=falkordb
FALKOR_PORT=6379
GRAPH_PREFIX=aftershock
# Required before exposing the console publicly. Keep the password private.
AFTERSHOCK_REQUIRE_AUTH=false
AFTERSHOCK_OPERATOR_USER=operator
AFTERSHOCK_OPERATOR_PASSWORD=
# Enable when serving the console over HTTPS.
AFTERSHOCK_SECURE_COOKIE=false
